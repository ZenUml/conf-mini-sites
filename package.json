{
  "name": "conf-mini-sites",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Host a multi-file static bundle, embedded live in Confluence. Forge app shell + Cloudflare Workers for Platforms.",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo:test": "vitest run --config demo-pipeline/vitest.config.ts",
    "demo:typecheck": "tsc --noEmit -p demo-pipeline/tsconfig.json",
    "demo:video": "tsx demo-pipeline/src/cli.ts run",
    "demo:render": "tsx demo-pipeline/src/cli.ts render",
    "promo:test": "vitest run --config promo/vitest.config.ts",
    "promo:typecheck": "tsc --noEmit -p promo/tsconfig.json",
    "promo:audio": "tsx promo/edit/build-audio.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240909.0",
    "@playwright/test": "^1.61.0",
    "@types/node": "^22.19.21",
    "otpauth": "^9.5.1",
    "tsx": "^4.23.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1",
    "zod": "^4.4.3"
  },
  "dependencies": {
    "jose": "^6.2.3"
  }
}
